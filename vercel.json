{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "api/sitemap.js",
      "use": "@vercel/node"
    }
  ],
  
"routes": [
  {
    "src": "^/sitemap\\.xml$",
    "dest": "/api/sitemap"
  },
  {
    "src": "^/api/sitemap$",
    "dest": "/api/sitemap"
  },
  {
    "src": "/(?!.*\\..*$)(.*)",
    "dest": "/index.html"
  }
],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
